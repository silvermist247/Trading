    def _update_live_tick_counts(self, current_price: float) -> None:
        # BUY/SELL labels proxy up/down price moves; OHLCV has no aggressor-side data.
        self._tick_flash_side = 0
        if isnan(current_price):
            return
        if self._tick_count_bar_index != self.bar_index:
            if self._tick_count_bar_index >= 0:
                if self.bar_index == self._tick_count_bar_index + 1:
                    # Store only completed candles; averages ignore the live candle.
                    self._tick_up_history.append(self._tick_up_count)
                    self._tick_down_history.append(self._tick_down_count)
                    if len(self._tick_up_history) > 20:
                        self._tick_up_history.pop(0)
                    if len(self._tick_down_history) > 20:
                        self._tick_down_history.pop(0)
                else:
                    # Clear stale history if replay or a chart jump breaks bar sequence.
                    self._tick_up_history = [0]
                    self._tick_down_history = [0]
                    self._tick_up_history.pop(0)
                    self._tick_down_history.pop(0)
            self._tick_count_bar_index = self.bar_index
            self._tick_count_last_price = current_price
            self._tick_up_count = 0
            self._tick_down_count = 0
            return
        if isnan(self._tick_count_last_price):
            self._tick_count_last_price = current_price
            return
        if current_price > self._tick_count_last_price:
            self._tick_up_count = self._tick_up_count + 1
            self._tick_flash_side = 1
        elif current_price < self._tick_count_last_price:
            self._tick_down_count = self._tick_down_count + 1
            self._tick_flash_side = -1
        self._tick_count_last_price = current_price

    def _record_policy_reward(self, regime_index: int, policy_index: int,
                              reward: float) -> None:
        if regime_index < 0 or regime_index > 2:
            return
        if policy_index < 0 or policy_index > 2:
            return
        policy_slot = regime_index * 3 + policy_index
        self._sim_policy_reward_sums[policy_slot] = (
            self._sim_policy_reward_sums[policy_slot] + reward
        )
        self._sim_policy_counts[policy_slot] = (
            self._sim_policy_counts[policy_slot] + 1.0
        )

    def _select_exit_policy(self, regime_index: int) -> int:
        if regime_index < 0 or regime_index > 2:
            return 1
        first_slot = regime_index * 3
        conservative_count = self._sim_policy_counts[first_slot]
        baseline_count = self._sim_policy_counts[first_slot + 1]
        trend_count = self._sim_policy_counts[first_slot + 2]
        least_count = conservative_count
        selected_policy = 0
        if baseline_count < least_count:
            least_count = baseline_count
            selected_policy = 1
        if trend_count < least_count:
            least_count = trend_count
            selected_policy = 2
        # Rotate the bounded templates once per chart bar during warm-up. Rotating
        # by bars (not fills) prevents a rejected plan from trapping one policy forever.
        # After five outcomes per template, choose challengers only if they beat the
        # baseline by 0.10 net R.
        if least_count < 5.0:
            if self._sim_policy_last_bar[regime_index] != self.bar_index:
                self._sim_policy_last_bar[regime_index] = self.bar_index
                self._sim_policy_attempts[regime_index] = (
                    self._sim_policy_attempts[regime_index] + 1
                )
            exploration_turn = self._sim_policy_attempts[regime_index] - 1
            return exploration_turn % 3
        # A zero-reward prior with five pseudo-observations shrinks small samples.
        baseline_mean = (
            self._sim_policy_reward_sums[first_slot + 1] / (baseline_count + 5.0)
        )
        best_mean = baseline_mean
        selected_policy = 1
        conservative_mean = (
            self._sim_policy_reward_sums[first_slot] / (conservative_count + 5.0)
        )
        if conservative_mean > best_mean + 0.10:
            best_mean = conservative_mean
            selected_policy = 0
        trend_mean = (
            self._sim_policy_reward_sums[first_slot + 2] / (trend_count + 5.0)
        )
        if trend_mean > best_mean + 0.10:
            selected_policy = 2
        return selected_policy

    def _update_drawdown_state(self, account_equity_quote: float,
                               max_drawdown_pct: float) -> None:
        if account_equity_quote <= 0.0:
            return
        current_equity = account_equity_quote + self._sim_realized_pnl
        if isnan(self._sim_peak_equity) or self._sim_peak_equity <= 0.0:
            self._sim_peak_equity = account_equity_quote
        if current_equity > self._sim_peak_equity:
            self._sim_peak_equity = current_equity
        if self._sim_peak_equity > 0.0:
            drawdown_amount = self._sim_peak_equity - current_equity
            if drawdown_amount < 0.0:
                drawdown_amount = 0.0
            self._sim_drawdown_pct = (
                drawdown_amount / self._sim_peak_equity * 100.0
            )
            if self._sim_drawdown_pct >= max_drawdown_pct:
                self._sim_risk_locked = True

    def _settle_sim_trade(self, exit_price: float, exit_type: int,
                          account_equity_quote: float,
                          max_drawdown_pct: float) -> None:
        prior_drawdown_pct = self._sim_drawdown_pct
        trade_move = (exit_price - self._sim_entry_price) * self._sim_side
        trade_cost = self._sim_entry_price * self._sim_entry_cost_pct / 100.0
        net_move = trade_move - trade_cost
        trade_pnl = net_move * self._sim_units
        self._sim_realized_pnl = self._sim_realized_pnl + trade_pnl
        self._update_drawdown_state(account_equity_quote, max_drawdown_pct)
        drawdown_increase = self._sim_drawdown_pct - prior_drawdown_pct
        if drawdown_increase < 0.0:
            drawdown_increase = 0.0
        if (not isnan(self._sim_initial_risk_per_unit)
                and self._sim_initial_risk_per_unit > 0.0):
            self._sim_last_net_r = net_move / self._sim_initial_risk_per_unit
            self._sim_last_reward = self._sim_last_net_r
            if exit_type == 2:
                self._sim_last_reward = self._sim_last_reward - 0.05
            self._sim_last_reward = (
                self._sim_last_reward - drawdown_increase * 0.10
            )
            self._record_policy_reward(
                self._sim_regime_index,
                self._sim_policy_index,
                self._sim_last_reward,
            )

        self._sim_exit_event_bar = self.bar_index
        self._sim_exit_event_type = exit_type
        self._sim_exit_event_price = exit_price
        if exit_type == 1:
            self._sim_tp_count = self._sim_tp_count + 1
        elif exit_type == -1:
            self._sim_stop_count = self._sim_stop_count + 1
        elif exit_type == 2:
            self._sim_reversal_count = self._sim_reversal_count + 1

        if not isnan(self._sim_entry_time) and not isnan(self.time[0]):
            exit_line_color = color.rgba(0, 255, 0, 1.0)
            if exit_type == -1:
                exit_line_color = color.rgba(255, 0, 180, 1.0)
            elif exit_type == 2:
                exit_line_color = color.rgba(255, 165, 0, 1.0)
            elif exit_type == -2:
                exit_line_color = color.rgba(255, 220, 0, 1.0)
            self.chart.draw(
                LineSegment(
                    AbsolutePosition(self._sim_entry_time, self._sim_entry_price),
                    AbsolutePosition(self.time[0], exit_price),
                    color=exit_line_color,
                    line_width=2,
                )
            )

        self._sim_side = 0
        self._sim_entry_price = nan
        self._sim_entry_time = nan
        self._sim_stop = nan
        self._sim_target = nan
        self._sim_units = 0.0
        self._sim_initial_risk_per_unit = nan

    def _center_text_line(self, text: str, width: int) -> str:
        padding_count = int((width - len(text)) / 2.0)
        left_padding = ''
        for pad_index in range(padding_count):
            left_padding = left_padding + ' '
        return left_padding + text

    def _new_mtf_frame(self, minutes: int) -> dict[str, float]:
        return {
            'minutes': minutes * 1.0,
            'bucket': -1.0,
            'has_aggregate': 0.0,
            'finalized': 0.0,
            'aggregate_open': nan,
            'aggregate_high': nan,
            'aggregate_low': nan,
            'aggregate_close': nan,
            'aggregate_volume': 0.0,
            'aggregate_count': 0.0,
            'closed_count': 0.0,
            'fast_seed_sum': 0.0,
            'slow_seed_sum': 0.0,
            'fast_ema': nan,
            'slow_ema': nan,
            'atr_seed_sum': 0.0,
            'atr_count': 0.0,
            'atr_value': nan,
            'previous_close': nan,
            'rsi_gain_sum': 0.0,
            'rsi_loss_sum': 0.0,
            'rsi_count': 0.0,
            'average_gain': nan,
            'average_loss': nan,
            'rsi_value': nan,
            'bb_middle': nan,
            'volume_ok': 0.0,
            'trend': 0.0,
            'score': 0.0,
            'ready': 0.0,
        }

    def _start_mtf_aggregate(self, frame_index: int, bucket: int,
                             open_value: float, high_value: float,
                             low_value: float, close_value: float,
                             volume_value: float) -> None:
        frame = self._mtf_frames[frame_index]
        frame['bucket'] = bucket * 1.0
        frame['has_aggregate'] = 1.0
        frame['finalized'] = 0.0
        frame['aggregate_open'] = open_value
        frame['aggregate_high'] = high_value
        frame['aggregate_low'] = low_value
        frame['aggregate_close'] = close_value
        frame['aggregate_volume'] = volume_value
        frame['aggregate_count'] = 1.0

    def _complete_mtf_aggregate(self, frame_index: int,
                                trend_length: int, radar_length: int,
                                volume_sma: int, band_length: int,
                                rsi_length: int) -> None:
        frame = self._mtf_frames[frame_index]
        close_value = frame['aggregate_close']
        high_value = frame['aggregate_high']
        low_value = frame['aggregate_low']
        volume_value = frame['aggregate_volume']
        previous_close = frame['previous_close']
        completed_count = frame['closed_count'] + 1.0
        slow_length = trend_length * 2

        if completed_count <= trend_length:
            frame['fast_seed_sum'] = frame['fast_seed_sum'] + close_value
            if completed_count == trend_length:
                frame['fast_ema'] = frame['fast_seed_sum'] / trend_length
        else:
            alpha_fast = 2.0 / (trend_length + 1.0)
            frame['fast_ema'] = (
                alpha_fast * close_value
                + (1.0 - alpha_fast) * frame['fast_ema']
            )

        if completed_count <= slow_length:
            frame['slow_seed_sum'] = frame['slow_seed_sum'] + close_value
            if completed_count == slow_length:
                frame['slow_ema'] = frame['slow_seed_sum'] / slow_length
        else:
            alpha_slow = 2.0 / (slow_length + 1.0)
            frame['slow_ema'] = (
                alpha_slow * close_value
                + (1.0 - alpha_slow) * frame['slow_ema']
            )

        true_range = high_value - low_value
        if not isnan(previous_close):
            high_gap = abs(high_value - previous_close)
            low_gap = abs(low_value - previous_close)
            if high_gap > true_range:
                true_range = high_gap
            if low_gap > true_range:
                true_range = low_gap

        atr_count = frame['atr_count'] + 1.0
        if atr_count <= radar_length:
            frame['atr_seed_sum'] = frame['atr_seed_sum'] + true_range
            if atr_count == radar_length:
                frame['atr_value'] = frame['atr_seed_sum'] / radar_length
        else:
            frame['atr_value'] = (
                frame['atr_value'] * (radar_length - 1.0) + true_range
            ) / radar_length
        frame['atr_count'] = atr_count

        if not isnan(previous_close):
            change = close_value - previous_close
            gain = 0.0
            loss = 0.0
            if change > 0:
                gain = change
            elif change < 0:
                loss = -change

            if frame['rsi_count'] < rsi_length:
                frame['rsi_gain_sum'] = frame['rsi_gain_sum'] + gain
                frame['rsi_loss_sum'] = frame['rsi_loss_sum'] + loss
                frame['rsi_count'] = frame['rsi_count'] + 1.0
                if frame['rsi_count'] == rsi_length:
                    frame['average_gain'] = frame['rsi_gain_sum'] / rsi_length
                    frame['average_loss'] = frame['rsi_loss_sum'] / rsi_length
            else:
                frame['average_gain'] = (
                    frame['average_gain'] * (rsi_length - 1.0) + gain
                ) / rsi_length
                frame['average_loss'] = (
                    frame['average_loss'] * (rsi_length - 1.0) + loss
                ) / rsi_length

            if frame['rsi_count'] >= rsi_length:
                if frame['average_loss'] == 0:
                    frame['rsi_value'] = 100.0
                else:
                    relative_strength = frame['average_gain'] / frame['average_loss']
                    frame['rsi_value'] = 100.0 - 100.0 / (1.0 + relative_strength)

        volume_history = self._mtf_volume_histories[frame_index]
        volume_average = nan
        if len(volume_history) >= volume_sma:
            volume_total = 0.0
            for old_volume in volume_history:
                volume_total = volume_total + old_volume
            volume_average = volume_total / volume_sma
        frame['volume_ok'] = 0.0
        if not isnan(volume_average) and volume_value > volume_average:
            frame['volume_ok'] = 1.0
        volume_history.append(volume_value)
        if len(volume_history) > volume_sma:
            volume_history.pop(0)

        close_history = self._mtf_close_histories[frame_index]
        close_history.append(close_value)
        if len(close_history) > band_length:
            close_history.pop(0)
        frame['bb_middle'] = nan
        if len(close_history) == band_length:
            close_total = 0.0
            for old_close in close_history:
                close_total = close_total + old_close
            frame['bb_middle'] = close_total / band_length

        trend = 0
        if (not isnan(frame['atr_value'])
                and not isnan(frame['fast_ema'])
                and not isnan(frame['slow_ema'])
                and frame['atr_value'] > 0):
            ema_spread = abs(frame['fast_ema'] - frame['slow_ema'])
            if ema_spread >= frame['atr_value'] * 0.1:
                if frame['fast_ema'] > frame['slow_ema']:
                    trend = 1
                else:
                    trend = -1

        score = 0
        if trend != 0:
            score = score + trend * 2
        if not isnan(frame['bb_middle']):
            if close_value > frame['bb_middle']:
                score = score + 1
            elif close_value < frame['bb_middle']:
                score = score - 1
        if not isnan(frame['rsi_value']):
            if frame['rsi_value'] >= 55.0:
                score = score + 1
            elif frame['rsi_value'] <= 45.0:
                score = score - 1
        bar_range = high_value - low_value
        candle_body = abs(close_value - frame['aggregate_open'])
        if bar_range > 0:
            if (close_value > frame['aggregate_open']
                    and candle_body >= bar_range * 0.3
                    and close_value >= low_value + bar_range * 0.65):
                score = score + 1
            elif (close_value < frame['aggregate_open']
                    and candle_body >= bar_range * 0.3
                    and close_value <= low_value + bar_range * 0.35):
                score = score - 1
        if trend != 0 and frame['volume_ok']:
            score = score + trend

        warmup_count = slow_length
        if radar_length > warmup_count:
            warmup_count = radar_length
        if rsi_length + 1 > warmup_count:
            warmup_count = rsi_length + 1
        if band_length > warmup_count:
            warmup_count = band_length
        if volume_sma + 1 > warmup_count:
            warmup_count = volume_sma + 1

        frame['closed_count'] = completed_count
        frame['previous_close'] = close_value
        frame['trend'] = trend * 1.0
        frame['score'] = score * 1.0
        frame['ready'] = 0.0
        if (completed_count >= warmup_count
                and not isnan(frame['fast_ema'])
                and not isnan(frame['slow_ema'])
                and not isnan(frame['atr_value'])
                and not isnan(frame['rsi_value'])
                and not isnan(frame['bb_middle'])
                and len(volume_history) >= volume_sma):
            frame['ready'] = 1.0

    def _update_multi_timeframe(self, current_time: float,
                                previous_time: float,
                                open_value: float, high_value: float,
                                low_value: float, close_value: float,
                                volume_value: float, trend_length: int,
                                radar_length: int, volume_sma: int,
                                band_length: int, rsi_length: int) -> None:
        if isnan(current_time) or isnan(previous_time):
            return
        time_delta = abs(current_time - previous_time)
        if time_delta >= 50.0 and time_delta <= 70.0:
            self._mtf_time_scale = 1
            self._mtf_chart_is_1m = True
        elif time_delta >= 50000.0 and time_delta <= 70000.0:
            self._mtf_time_scale = 1000
            self._mtf_chart_is_1m = True
        if not self._mtf_chart_is_1m:
            return

        frame_index = 0
        for frame in self._mtf_frames:
            interval = frame['minutes'] * 60 * self._mtf_time_scale
            source_bucket = int(previous_time / interval)
            if not frame['has_aggregate']:
                self._start_mtf_aggregate(
                    frame_index, source_bucket, open_value, high_value,
                    low_value, close_value, volume_value,
                )
            elif source_bucket != frame['bucket']:
                if not frame['finalized']:
                    self._complete_mtf_aggregate(
                        frame_index, trend_length, radar_length, volume_sma,
                        band_length, rsi_length,
                    )
                self._start_mtf_aggregate(
                    frame_index, source_bucket, open_value, high_value,
                    low_value, close_value, volume_value,
                )
            else:
                if high_value > frame['aggregate_high']:
                    frame['aggregate_high'] = high_value
                if low_value < frame['aggregate_low']:
                    frame['aggregate_low'] = low_value
                frame['aggregate_close'] = close_value
                frame['aggregate_volume'] = frame['aggregate_volume'] + volume_value
                frame['aggregate_count'] = frame['aggregate_count'] + 1.0

            current_bucket = int(current_time / interval)
            if (current_bucket != frame['bucket']
                    and not frame['finalized']):
                self._complete_mtf_aggregate(
                    frame_index, trend_length, radar_length, volume_sma,
                    band_length, rsi_length,
                )
                frame['finalized'] = 1.0
            frame_index = frame_index + 1

    def calc(
        self,
        trend_length,
        radar_length,
        volume_sma,
        level_lookback,
        band_length,
        band_multiplier,
        rsi_length,
        tp_atr_multiple,
        stop_buffer_atr,
        max_stop_atr,
        min_reward_risk,
        pullback_tolerance_atr,
        minimum_entry_score,
        risk_per_trade_pct,
        round_trip_cost_pct,
        account_equity_quote,
        continuous_exposure,
        reverse_confirm_bars,
        stop_cooldown_bars,
        max_drawdown_pct,
        chart_chat_question,
    ):
        current_price = self.close[0]
        self._update_drawdown_state(account_equity_quote, max_drawdown_pct)
        new_sim_bar = self.bar_index != self._sim_bar_index
        if (self._mtf_trend_length != trend_length
                or self._mtf_radar_length != radar_length
                or self._mtf_volume_sma != volume_sma
                or self._mtf_band_length != band_length
                or self._mtf_rsi_length != rsi_length):
            self._mtf_trend_length = trend_length
            self._mtf_radar_length = radar_length
            self._mtf_volume_sma = volume_sma
            self._mtf_band_length = band_length
            self._mtf_rsi_length = rsi_length
            self._mtf_time_scale = 0
            self._mtf_chart_is_1m = False
            self._mtf_frames = [
                self._new_mtf_frame(5),
                self._new_mtf_frame(15),
                self._new_mtf_frame(60),
                self._new_mtf_frame(240),
            ]
            self._mtf_close_histories = [[0.0], [0.0], [0.0], [0.0]]
            self._mtf_volume_histories = [[0.0], [0.0], [0.0], [0.0]]
            for history in self._mtf_close_histories:
                history.pop(0)
            for history in self._mtf_volume_histories:
                history.pop(0)
        if new_sim_bar and len(self.close) >= 2:
            self._update_multi_timeframe(
                self.time[0], self.time[1],
                self.open[1], self.high[1], self.low[1],
                self.close[1], self.volume[1], trend_length,
                radar_length, volume_sma, band_length, rsi_length,
            )
        price_changed = False
        price_went_up = False
        price_went_down = False
        if self.is_last_bar:
            self._update_live_tick_counts(current_price)
            if self._has_live_baseline and not isnan(self._last_live_price):
                if current_price > self._last_live_price:
                    price_changed = True
                    price_went_up = True
                elif current_price < self._last_live_price:
                    price_changed = True
                    price_went_down = True
            self._last_live_price = current_price
            self._has_live_baseline = True

        fast_ema = Ema.new(self.close, trend_length)
        slow_ema = Ema.new(self.close, trend_length * 2)
        ema_up = fast_ema[0] > slow_ema[0]

        atr_value = nan
        atr_previous = nan
        atr_slow_value = nan
        if len(self.close) >= radar_length:
            atr_series = Atr.new(radar_length)
            atr_value = atr_series[0]
            if len(self.close) >= radar_length + 1:
                atr_previous = atr_series[1]
        if len(self.close) >= radar_length * 3:
            atr_slow_value = Atr.new(radar_length * 3)[0]
        high_volatility = False
        if (atr_value > 0 and atr_slow_value > 0
                and atr_value >= atr_slow_value * 1.25):
            high_volatility = True

        volume_ready = False
        volume_ok = False
        previous_volume_ok = False
        if len(self.close) >= volume_sma:
            volume_average = Sma.new(self.volume, volume_sma)
            volume_reference = volume_average[0]
            if len(self.close) >= volume_sma + 1:
                volume_reference = volume_average[1]
            if len(self.close) >= volume_sma + 2:
                previous_volume_ok = self.volume[1] > volume_average[2]
            volume_ready = True
            volume_ok = self.volume[0] > volume_reference

        support = nan
        resistance = nan
        prior_support = nan
        prior_resistance = nan
        resistance_two_bars_ago = nan
        support_two_bars_ago = nan
        if len(self.close) >= level_lookback:
            low_series = Lowest.new(self.low, level_lookback)
            high_series = Highest.new(self.high, level_lookback)
            support = low_series[0]
            resistance = high_series[0]
            if len(self.close) >= level_lookback + 1:
                prior_support = low_series[1]
                prior_resistance = high_series[1]
            if len(self.close) >= level_lookback + 2:
                support_two_bars_ago = low_series[2]
                resistance_two_bars_ago = high_series[2]

        bb_lower = nan
        bb_middle = nan
        bb_upper = nan
        if len(self.close) >= band_length:
            bb_lower_series, bb_middle_series, bb_upper_series = Bb.new(
                self.close, band_length, band_multiplier,
            )
            bb_lower = bb_lower_series[0]
            bb_middle = bb_middle_series[0]
            bb_upper = bb_upper_series[0]

        rsi_value = nan
        if len(self.close) >= rsi_length:
            rsi_value = Rsi.new(self.close, rsi_length)[0]

        market_trending = False
        if atr_value > 0:
            ema_spread = abs(fast_ema[0] - slow_ema[0])
            if ema_spread >= atr_value * 0.1:
                market_trending = True

        market_text = 'RANGE'
        if market_trending:
            if ema_up:
                market_text = 'UPTREND'
            else:
                market_text = 'DOWNTREND'

        mtf_5m = self._mtf_frames[0]
        mtf_15m = self._mtf_frames[1]
        mtf_1h = self._mtf_frames[2]
        mtf_4h = self._mtf_frames[3]
        mtf_ready = self._mtf_chart_is_1m
        for mtf_frame in self._mtf_frames:
            if not mtf_frame['ready']:
                mtf_ready = False
        # Weighted MTF rule: 5m/15m/1h/4h scores weigh 1/2/3/4; 15m
        # direction must agree, while 1h and 4h must not oppose the entry.
        # This is a confluence filter, not a claim of an optimal or profitable strategy.
        mtf_weighted_score = (
            mtf_5m['score']
            + mtf_15m['score'] * 2
            + mtf_1h['score'] * 3
            + mtf_4h['score'] * 4
        )
        mtf_long_ok = (
            mtf_ready
            and mtf_15m['trend'] > 0
            and mtf_1h['trend'] >= 0
            and mtf_4h['trend'] >= 0
            and mtf_weighted_score >= 8
        )
        mtf_short_ok = (
            mtf_ready
            and mtf_15m['trend'] < 0
            and mtf_1h['trend'] <= 0
            and mtf_4h['trend'] <= 0
            and mtf_weighted_score <= -8
        )

        # Transparent confluence points: EMA/ATR direction (2), Bollinger mid (1),
        # RSI extremes (1), and above-average volume in trend direction (1).
        # Points are rule alignment, not a win probability.
        confluence = 0
        if market_trending:
            if ema_up:
                confluence = confluence + 2
            else:
                confluence = confluence - 2
        if not isnan(bb_middle):
            if self.close[0] > bb_middle:
                confluence = confluence + 1
            elif self.close[0] < bb_middle:
                confluence = confluence - 1
        if not isnan(rsi_value):
            if rsi_value >= 55.0:
                confluence = confluence + 1
            elif rsi_value <= 45.0:
                confluence = confluence - 1
        if market_trending and volume_ready and volume_ok:
            if ema_up:
                confluence = confluence + 1
            else:
                confluence = confluence - 1

        regime_index = 0
        if market_trending:
            regime_index = 1
        if high_volatility:
            regime_index = 2
        selected_policy_index = self._select_exit_policy(regime_index)
        selected_policy_name = 'BASE'
        target_scale = 1.0
        effective_stop_buffer_atr = stop_buffer_atr
        if selected_policy_index == 0:
            selected_policy_name = 'SAFE'
            target_scale = 0.8
            effective_stop_buffer_atr = stop_buffer_atr * 0.9
        elif selected_policy_index == 2:
            selected_policy_name = 'TRAIL'
            target_scale = 1.2
        if high_volatility:
            target_scale = target_scale * 0.9
        effective_tp_multiple = tp_atr_multiple * target_scale
        if effective_tp_multiple > 4.0:
            effective_tp_multiple = 4.0

        near_support = False
        near_resistance = False
        if atr_value > 0 and not isnan(support) and not isnan(resistance):
            if abs(self.close[0] - support) <= atr_value * 0.5:
                near_support = True
            if abs(self.close[0] - resistance) <= atr_value * 0.5:
                near_resistance = True

        upside_breakout = False
        downside_breakdown = False
        if not isnan(prior_resistance) and self.close[0] > prior_resistance:
            upside_breakout = True
        if not isnan(prior_support) and self.close[0] < prior_support:
            downside_breakdown = True

        bullish_candle = False
        bearish_candle = False
        bullish_confirmation = False
        bearish_confirmation = False
        bar_range = self.high[0] - self.low[0]
        candle_body = abs(self.close[0] - self.open[0])
        if len(self.close) >= 2 and bar_range > 0:
            if (self.close[0] > self.open[0]
                    and candle_body >= bar_range * 0.3
                    and self.close[0] >= self.low[0] + bar_range * 0.65):
                bullish_candle = True
                if self.close[0] > self.close[1]:
                    bullish_confirmation = True
            if (self.close[0] < self.open[0]
                    and candle_body >= bar_range * 0.3
                    and self.close[0] <= self.low[0] + bar_range * 0.35):
                bearish_candle = True
                if self.close[0] < self.close[1]:
                    bearish_confirmation = True

        long_momentum_ok = False
        short_momentum_ok = False
        if not isnan(rsi_value):
            if rsi_value >= 45.0 and rsi_value <= 75.0:
                long_momentum_ok = True
            if rsi_value >= 25.0 and rsi_value <= 55.0:
                short_momentum_ok = True

        long_ema_pullback = False
        short_ema_pullback = False
        if atr_value > 0 and market_trending:
            if (ema_up
                    and self.low[0] <= fast_ema[0] + atr_value * pullback_tolerance_atr
                    and self.close[0] > fast_ema[0]):
                long_ema_pullback = True
            if (not ema_up
                    and self.high[0] >= fast_ema[0] - atr_value * pullback_tolerance_atr
                    and self.close[0] < fast_ema[0]):
                short_ema_pullback = True

        # A conservative first-break close can enter without waiting for a full retest,
        # but only with trend, volume, a strong close, and limited extension beyond the level.
        long_breakout_continuation = False
        short_breakdown_continuation = False
        if (len(self.close) >= level_lookback + 2
                and atr_value > 0
                and not isnan(prior_resistance)
                and not isnan(resistance_two_bars_ago)):
            if (self.close[0] > prior_resistance
                    and self.close[1] <= resistance_two_bars_ago
                    and market_trending and ema_up
                    and confluence >= minimum_entry_score
                    and volume_ok and long_momentum_ok and bullish_candle
                    and current_price > fast_ema[0]
                    and current_price - prior_resistance <= atr_value * 0.75):
                long_breakout_continuation = True

        if (len(self.close) >= level_lookback + 2
                and atr_value > 0
                and not isnan(prior_support)
                and not isnan(support_two_bars_ago)):
            if (self.close[0] < prior_support
                    and self.close[1] >= support_two_bars_ago
                    and market_trending and not ema_up
                    and confluence <= -minimum_entry_score
                    and volume_ok and short_momentum_ok and bearish_candle
                    and current_price < fast_ema[0]
                    and prior_support - current_price <= atr_value * 0.75):
                short_breakdown_continuation = True

        # Also retain the stricter follow-up retest path after a prior-bar breakout.
        long_breakout_retest = False
        short_breakdown_retest = False
        if (len(self.close) >= level_lookback + 2
                and len(self.close) >= volume_sma + 2
                and len(self.close) >= trend_length * 2 + 2
                and atr_value > 0
                and previous_volume_ok):
            prior_bar_broke_up = (
                self.close[1] > resistance_two_bars_ago
                and self.close[1] > self.open[1]
                and fast_ema[1] > slow_ema[1]
            )
            prior_bar_broke_down = (
                self.close[1] < support_two_bars_ago
                and self.close[1] < self.open[1]
                and fast_ema[1] < slow_ema[1]
            )
            if (prior_bar_broke_up and market_trending and ema_up
                    and confluence >= 2 and long_momentum_ok
                    and self.low[0] <= resistance_two_bars_ago + atr_value * 0.2
                    and self.close[0] > resistance_two_bars_ago + atr_value * 0.05
                    and bullish_candle):
                long_breakout_retest = True
            if (prior_bar_broke_down and market_trending and not ema_up
                    and confluence <= -2 and short_momentum_ok
                    and self.high[0] >= support_two_bars_ago - atr_value * 0.2
                    and self.close[0] < support_two_bars_ago - atr_value * 0.05
                    and bearish_candle):
                short_breakdown_retest = True

        # Avoid opening into an immediate obstacle: require at least 0.5 ATR of room.
        long_room_ok = True
        short_room_ok = True
        if atr_value > 0 and not isnan(prior_resistance):
            if (prior_resistance > current_price
                    and prior_resistance - current_price <= atr_value * 0.5):
                long_room_ok = False
        if atr_value > 0 and not isnan(prior_support):
            if (prior_support < current_price
                    and current_price - prior_support <= atr_value * 0.5):
                short_room_ok = False

        # Risk gates: define a structural stop, reject excessive stop distances, and
        # require minimum estimated net reward/risk after the configured cost allowance.
        # Targets/stops remain references; this indicator cannot place or guarantee orders.
        long_target_value = nan
        short_target_value = nan
        long_stop_value = nan
        short_stop_value = nan
        long_stop_distance = nan
        short_stop_distance = nan
        long_risk_unit_distance = nan
        short_risk_unit_distance = nan
        long_reward_risk = nan
        short_reward_risk = nan
        long_risk_ok = False
        short_risk_ok = False
        equity_configured = account_equity_quote > 0.0
        risk_ready = (
            equity_configured and risk_per_trade_pct > 0.0
            and not self._sim_risk_locked
        )
        risk_budget_quote = nan
        if risk_ready:
            current_equity = account_equity_quote + self._sim_realized_pnl
            if current_equity > 0.0:
                risk_budget_quote = current_equity * risk_per_trade_pct / 100.0
            else:
                risk_ready = False

        if atr_value > 0:
            long_target_value = current_price + atr_value * effective_tp_multiple
            if (not isnan(prior_resistance)
                    and prior_resistance > current_price + atr_value * 0.5
                    and prior_resistance <= current_price + atr_value * effective_tp_multiple * 2.0):
                long_target_value = prior_resistance - atr_value * 0.1

            short_target_value = current_price - atr_value * effective_tp_multiple
            if (not isnan(prior_support)
                    and prior_support < current_price - atr_value * 0.5
                    and prior_support >= current_price - atr_value * effective_tp_multiple * 2.0):
                short_target_value = prior_support + atr_value * 0.1

            long_stop_anchor = nan
            if long_breakout_retest and not isnan(resistance_two_bars_ago):
                long_stop_anchor = self.low[0]
                if resistance_two_bars_ago < long_stop_anchor:
                    long_stop_anchor = resistance_two_bars_ago
            elif long_breakout_continuation and not isnan(prior_resistance):
                long_stop_anchor = self.low[0]
                if prior_resistance < long_stop_anchor:
                    long_stop_anchor = prior_resistance
            elif long_ema_pullback:
                long_stop_anchor = self.low[0]
            elif not isnan(support):
                long_stop_anchor = support
            if not isnan(long_stop_anchor):
                long_stop_value = long_stop_anchor - atr_value * effective_stop_buffer_atr

            short_stop_anchor = nan
            if short_breakdown_retest and not isnan(support_two_bars_ago):
                short_stop_anchor = self.high[0]
                if support_two_bars_ago > short_stop_anchor:
                    short_stop_anchor = support_two_bars_ago
            elif short_breakdown_continuation and not isnan(prior_support):
                short_stop_anchor = self.high[0]
                if prior_support > short_stop_anchor:
                    short_stop_anchor = prior_support
            elif short_ema_pullback:
                short_stop_anchor = self.high[0]
            elif not isnan(resistance):
                short_stop_anchor = resistance
            if not isnan(short_stop_anchor):
                short_stop_value = short_stop_anchor + atr_value * effective_stop_buffer_atr

            if (long_stop_value < current_price
                    and long_target_value > current_price):
                long_stop_distance = current_price - long_stop_value
                long_reward_distance = long_target_value - current_price
                long_cost_per_unit = current_price * round_trip_cost_pct / 100.0
                long_net_reward = long_reward_distance - long_cost_per_unit
                long_risk_unit_distance = long_stop_distance + long_cost_per_unit
                if long_risk_unit_distance > 0:
                    long_reward_risk = long_net_reward / long_risk_unit_distance
                    if (long_stop_distance <= atr_value * max_stop_atr
                            and long_net_reward > 0
                            and long_reward_risk >= min_reward_risk):
                        long_risk_ok = True

            if (short_stop_value > current_price
                    and short_target_value < current_price):
                short_stop_distance = short_stop_value - current_price
                short_reward_distance = current_price - short_target_value
                short_cost_per_unit = current_price * round_trip_cost_pct / 100.0
                short_net_reward = short_reward_distance - short_cost_per_unit
                short_risk_unit_distance = short_stop_distance + short_cost_per_unit
                if short_risk_unit_distance > 0:
                    short_reward_risk = short_net_reward / short_risk_unit_distance
                    if (short_stop_distance <= atr_value * max_stop_atr
                            and short_net_reward > 0
                            and short_reward_risk >= min_reward_risk):
                        short_risk_ok = True

        # Sensitivity is adjustable by score/tolerance; every setup still needs a
        # directional close, momentum, room, and a valid stop/target plan.
        long_setup_candidate = False
        short_setup_candidate = False
        if ((confluence >= minimum_entry_score and (near_support or long_ema_pullback)
                and not near_resistance and bullish_confirmation
                and long_momentum_ok and long_room_ok)
                or (long_breakout_retest and long_room_ok)
                or (long_breakout_continuation and long_room_ok)):
            long_setup_candidate = True
        if ((confluence <= -minimum_entry_score and (near_resistance or short_ema_pullback)
                and not near_support and bearish_confirmation
                and short_momentum_ok and short_room_ok)
                or (short_breakdown_retest and short_room_ok)
                or (short_breakdown_continuation and short_room_ok)):
            short_setup_candidate = True

        long_mtf_blocked = long_setup_candidate and long_risk_ok and not mtf_long_ok
        short_mtf_blocked = short_setup_candidate and short_risk_ok and not mtf_short_ok
        long_candidate = long_setup_candidate and long_risk_ok and mtf_long_ok
        short_candidate = short_setup_candidate and short_risk_ok and mtf_short_ok
        if long_candidate and short_candidate:
            long_candidate = False
            short_candidate = False

        reverse_threshold = minimum_entry_score + 1
        if reverse_threshold > 5:
            reverse_threshold = 5
        long_regime_ready = (
            mtf_long_ok and market_trending and ema_up
            and confluence >= minimum_entry_score
            and long_risk_ok and long_room_ok
        )
        short_regime_ready = (
            mtf_short_ok and market_trending and not ema_up
            and confluence <= -minimum_entry_score
            and short_risk_ok and short_room_ok
        )
        long_reverse_candidate = (
            mtf_long_ok and market_trending and ema_up
            and confluence >= reverse_threshold
            and long_risk_ok and long_room_ok
        )
        short_reverse_candidate = (
            mtf_short_ok and market_trending and not ema_up
            and confluence <= -reverse_threshold
            and short_risk_ok and short_room_ok
        )

        buy_entry_marker = nan
        sell_entry_marker = nan
        tp_reference_marker = nan
        stop_reference_marker = nan
        tp_exit_marker = nan
        stop_exit_marker = nan

        if new_sim_bar:
            self._sim_bar_index = self.bar_index
            self._sim_entry_event_bar = -1
            self._sim_entry_event_side = 0
            self._sim_entry_event_price = nan
            self._sim_stop_ref_event_bar = -1
            self._sim_stop_ref_event_price = nan
            self._sim_tp_ref_event_bar = -1
            self._sim_tp_ref_event_price = nan
            self._sim_exit_event_bar = -1
            self._sim_exit_event_type = 0
            self._sim_exit_event_price = nan

            pending_side = self._pending_side
            pending_stop = self._pending_stop
            pending_target = self._pending_target
            pending_max_stop_distance = self._pending_max_stop_distance
            pending_policy_index = self._pending_policy_index
            pending_regime_index = self._pending_regime_index
            self._pending_side = 0
            self._pending_stop = nan
            self._pending_target = nan
            self._pending_max_stop_distance = nan
            self._pending_policy_index = 1
            self._pending_regime_index = 0

            # Policy 2 trails only after the previous completed candle has moved
            # at least one initial R in favor. The stop can only tighten.
            if (self._sim_side != 0 and self._sim_policy_index == 2
                    and len(self.close) >= 2 and atr_previous > 0
                    and not isnan(self._sim_initial_risk_per_unit)):
                previous_move = (
                    (self.close[1] - self._sim_entry_price) * self._sim_side
                )
                if previous_move >= self._sim_initial_risk_per_unit:
                    if self._sim_side > 0:
                        trailing_stop = (
                            fast_ema[1] - atr_previous * stop_buffer_atr
                        )
                        breakeven_stop = (
                            self._sim_entry_price
                            + self._sim_entry_price * self._sim_entry_cost_pct / 100.0
                        )
                        if trailing_stop < breakeven_stop:
                            trailing_stop = breakeven_stop
                        if trailing_stop > self._sim_stop:
                            self._sim_stop = trailing_stop
                            self._sim_stop_ref_event_bar = self.bar_index
                            self._sim_stop_ref_event_price = self._sim_stop
                    else:
                        trailing_stop = (
                            fast_ema[1] + atr_previous * stop_buffer_atr
                        )
                        breakeven_stop = (
                            self._sim_entry_price
                            - self._sim_entry_price * self._sim_entry_cost_pct / 100.0
                        )
                        if trailing_stop > breakeven_stop:
                            trailing_stop = breakeven_stop
                        if trailing_stop < self._sim_stop:
                            self._sim_stop = trailing_stop
                            self._sim_stop_ref_event_bar = self.bar_index
                            self._sim_stop_ref_event_price = self._sim_stop

            reverse_confirmed = False
            if (continuous_exposure and self._sim_side != 0
                    and pending_side == -self._sim_side and pending_side != 0
                    and not self._sim_risk_locked):
                if self._sim_reverse_candidate_side == pending_side:
                    self._sim_reverse_confirm_count = (
                        self._sim_reverse_confirm_count + 1
                    )
                else:
                    self._sim_reverse_candidate_side = pending_side
                    self._sim_reverse_confirm_count = 1
                if self._sim_reverse_confirm_count >= reverse_confirm_bars:
                    reverse_confirmed = True
            else:
                self._sim_reverse_confirm_count = 0
                self._sim_reverse_candidate_side = 0

            entry_price = self.open[0]
            entry_geometry_ok = False
            entry_mtf_ok = False
            entry_risk_ok = False
            entry_stop_distance = nan
            entry_reward_distance = nan
            entry_risk_per_unit = nan
            if pending_side > 0 and mtf_long_ok:
                entry_mtf_ok = True
            elif pending_side < 0 and mtf_short_ok:
                entry_mtf_ok = True
            if pending_side > 0:
                if entry_price > pending_stop and entry_price < pending_target:
                    entry_geometry_ok = True
                    entry_stop_distance = entry_price - pending_stop
                    entry_reward_distance = pending_target - entry_price
            elif pending_side < 0:
                if entry_price < pending_stop and entry_price > pending_target:
                    entry_geometry_ok = True
                    entry_stop_distance = pending_stop - entry_price
                    entry_reward_distance = entry_price - pending_target

            if (entry_geometry_ok and entry_mtf_ok
                    and not isnan(pending_max_stop_distance)
                    and entry_stop_distance > 0):
                entry_cost_per_unit = entry_price * round_trip_cost_pct / 100.0
                entry_risk_per_unit = entry_stop_distance + entry_cost_per_unit
                entry_net_reward = entry_reward_distance - entry_cost_per_unit
                entry_reward_risk = nan
                if entry_risk_per_unit > 0:
                    entry_reward_risk = entry_net_reward / entry_risk_per_unit
                if (entry_stop_distance <= pending_max_stop_distance
                        and entry_net_reward > 0
                        and entry_reward_risk >= min_reward_risk):
                    entry_risk_ok = True

            allow_entry = self._sim_side == 0
            if (self._sim_side != 0 and reverse_confirmed
                    and entry_mtf_ok and not self._sim_risk_locked):
                reverse_exit_type = 2
                reverse_exit_price = entry_price
                if self._sim_side > 0:
                    if entry_price <= self._sim_stop:
                        reverse_exit_type = -1
                    elif entry_price >= self._sim_target:
                        reverse_exit_type = 1
                else:
                    if entry_price >= self._sim_stop:
                        reverse_exit_type = -1
                    elif entry_price <= self._sim_target:
                        reverse_exit_type = 1
                self._settle_sim_trade(
                    reverse_exit_price, reverse_exit_type,
                    account_equity_quote, max_drawdown_pct,
                )
                if reverse_exit_type == 2 and entry_risk_ok:
                    allow_entry = True
                else:
                    self._sim_cooldown_until_bar = (
                        self.bar_index + stop_cooldown_bars
                    )
                self._sim_reverse_confirm_count = 0
                self._sim_reverse_candidate_side = 0
            elif (continuous_exposure and self._sim_side != 0
                    and pending_side == -self._sim_side and not entry_mtf_ok):
                self._sim_reverse_confirm_count = 0
                self._sim_reverse_candidate_side = 0

            # Recheck MTF, gap geometry, estimated costs and risk at the next open.
            # A confirmed reversal closes the old side first, then opens only if the
            # opposite plan still passes every entry gate. No live order is sent.
            if (allow_entry and pending_side != 0 and entry_risk_ok
                    and not self._sim_risk_locked
                    and self.bar_index >= self._sim_cooldown_until_bar):
                sim_units = 1.0
                entry_equity = account_equity_quote + self._sim_realized_pnl
                if (equity_configured and risk_per_trade_pct > 0.0
                        and entry_equity > 0.0):
                    entry_risk_budget = entry_equity * risk_per_trade_pct / 100.0
                    sim_units = entry_risk_budget / entry_risk_per_unit
                if sim_units > 0.0:
                    self._sim_side = pending_side
                    self._sim_entry_price = entry_price
                    self._sim_entry_time = self.time[0]
                    self._sim_stop = pending_stop
                    self._sim_target = pending_target
                    self._sim_units = sim_units
                    self._sim_entry_cost_pct = round_trip_cost_pct
                    self._sim_initial_risk_per_unit = entry_risk_per_unit
                    self._sim_policy_index = pending_policy_index
                    self._sim_regime_index = pending_regime_index
                    self._sim_trade_count = self._sim_trade_count + 1
                    self._sim_entry_event_bar = self.bar_index
                    self._sim_entry_event_side = pending_side
                    self._sim_entry_event_price = entry_price
                    self._sim_stop_ref_event_bar = self.bar_index
                    self._sim_stop_ref_event_price = pending_stop
                    self._sim_tp_ref_event_bar = self.bar_index
                    self._sim_tp_ref_event_price = pending_target
                    self._sim_reverse_confirm_count = 0
                    self._sim_reverse_candidate_side = 0

        # Check open simulated positions on every live update. If one OHLC bar touches
        # both levels, resolve it conservatively as a stop-out before a target fill.
        if self._sim_side != 0:
            stop_hit = False
            target_hit = False
            exit_type = 0
            exit_price = nan
            if self._sim_side > 0:
                if self.low[0] <= self._sim_stop:
                    stop_hit = True
                if self.high[0] >= self._sim_target:
                    target_hit = True
            else:
                if self.high[0] >= self._sim_stop:
                    stop_hit = True
                if self.low[0] <= self._sim_target:
                    target_hit = True

            if stop_hit:
                exit_type = -1
                exit_price = self._sim_stop
                if self._sim_side > 0 and self.open[0] < self._sim_stop:
                    exit_price = self.open[0]
                elif self._sim_side < 0 and self.open[0] > self._sim_stop:
                    exit_price = self.open[0]
            elif target_hit:
                exit_type = 1
                exit_price = self._sim_target

            if exit_type == 0 and self._sim_risk_locked:
                exit_type = -2
                exit_price = current_price

            if exit_type != 0:
                self._settle_sim_trade(
                    exit_price, exit_type, account_equity_quote, max_drawdown_pct,
                )
                if exit_type == 1 or exit_type == -1:
                    self._sim_cooldown_until_bar = (
                        self.bar_index + stop_cooldown_bars
                    )
                self._sim_reverse_confirm_count = 0
                self._sim_reverse_candidate_side = 0

        # Queue continuous-mode entries from a strong MTF regime and reversals
        # only from the higher threshold. Legacy setup-only mode remains available.
        next_pending_side = 0
        next_pending_stop = nan
        next_pending_target = nan
        next_pending_max_stop_distance = nan
        if (self._sim_exit_event_bar != self.bar_index
                and not self._sim_risk_locked
                and self.bar_index >= self._sim_cooldown_until_bar):
            if continuous_exposure:
                if self._sim_side == 0:
                    next_long_ready = long_candidate or long_regime_ready
                    next_short_ready = short_candidate or short_regime_ready
                    if next_long_ready and not next_short_ready:
                        next_pending_side = 1
                        next_pending_stop = long_stop_value
                        next_pending_target = long_target_value
                    elif next_short_ready and not next_long_ready:
                        next_pending_side = -1
                        next_pending_stop = short_stop_value
                        next_pending_target = short_target_value
                elif self._sim_side > 0 and short_reverse_candidate:
                    next_pending_side = -1
                    next_pending_stop = short_stop_value
                    next_pending_target = short_target_value
                elif self._sim_side < 0 and long_reverse_candidate:
                    next_pending_side = 1
                    next_pending_stop = long_stop_value
                    next_pending_target = long_target_value
            elif self._sim_side == 0:
                if long_candidate and not short_candidate:
                    next_pending_side = 1
                    next_pending_stop = long_stop_value
                    next_pending_target = long_target_value
                elif short_candidate and not long_candidate:
                    next_pending_side = -1
                    next_pending_stop = short_stop_value
                    next_pending_target = short_target_value

        if next_pending_side != 0:
            self._pending_side = next_pending_side
            self._pending_stop = next_pending_stop
            self._pending_target = next_pending_target
            self._pending_max_stop_distance = atr_value * max_stop_atr
            self._pending_policy_index = selected_policy_index
            self._pending_regime_index = regime_index
        else:
            self._pending_side = 0
            self._pending_stop = nan
            self._pending_target = nan
            self._pending_max_stop_distance = nan
            self._pending_policy_index = 1
            self._pending_regime_index = 0

        if self._sim_entry_event_bar == self.bar_index:
            if self._sim_entry_event_side > 0:
                buy_entry_marker = self._sim_entry_event_price
            else:
                sell_entry_marker = self._sim_entry_event_price
        if self._sim_stop_ref_event_bar == self.bar_index:
            stop_reference_marker = self._sim_stop_ref_event_price
        if self._sim_tp_ref_event_bar == self.bar_index:
            tp_reference_marker = self._sim_tp_ref_event_price
        if self._sim_exit_event_bar == self.bar_index:
            if self._sim_exit_event_type == 1:
                tp_exit_marker = self._sim_exit_event_price
            elif self._sim_exit_event_type == -1 or self._sim_exit_event_type == -2:
                stop_exit_marker = self._sim_exit_event_price

        report_text = 'Mixed price action'
        if long_mtf_blocked or short_mtf_blocked:
            report_text = 'MTF filter; wait for alignment'
        elif long_breakout_continuation:
            report_text = 'Breakout confirmed; buy next open'
        elif short_breakdown_continuation:
            report_text = 'Breakdown confirmed; sell next open'
        elif long_breakout_retest:
            report_text = 'Breakout retest confirmed'
        elif short_breakdown_retest:
            report_text = 'Breakdown retest confirmed'
        elif upside_breakout:
            report_text = 'Breakout; wait retest'
        elif downside_breakdown:
            report_text = 'Breakdown; wait retest'
        elif near_support:
            report_text = 'SUP test; buyers unconfirmed'
        elif near_resistance:
            report_text = 'RES test; sellers unconfirmed'
        elif market_trending and ema_up:
            report_text = 'Bullish EMA pressure'
        elif market_trending:
            report_text = 'Bearish EMA pressure'

        scenario_text = 'MIXED: wait for setup'
        if long_candidate:
            scenario_text = 'LONG WATCH: bull close'
        elif short_candidate:
            scenario_text = 'SHORT WATCH: bear close'
        elif upside_breakout:
            scenario_text = 'BREAKOUT: wait retest'
        elif downside_breakdown:
            scenario_text = 'BREAKDOWN: wait retest'
        elif confluence >= 3 and near_support:
            scenario_text = 'SUP: quality filter'
        elif confluence <= -3 and near_resistance:
            scenario_text = 'RES: quality filter'
        elif confluence >= 3:
            scenario_text = 'BULLISH: wait pullback'
        elif confluence <= -3:
            scenario_text = 'BEARISH: wait rally'
        if long_setup_candidate and not long_risk_ok:
            scenario_text = 'RISK FILTER: stop/RR'
        elif short_setup_candidate and not short_risk_ok:
            scenario_text = 'RISK FILTER: stop/RR'
        elif long_mtf_blocked or short_mtf_blocked:
            scenario_text = 'MTF FILTER: WAIT ALIGNMENT'
        elif not risk_ready and not long_candidate and not short_candidate:
            scenario_text = 'SIM: 1 UNIT'
        if self._sim_risk_locked:
            scenario_text = 'HARD DRAWDOWN LOCK'

        price_precision = self.info.price_precision
        if price_precision > 5:
            price_precision = 2
        price_text = str(round(self.close[0], price_precision))
        confluence_text = str(confluence)
        if confluence > 0:
            confluence_text = '+' + confluence_text

        mtf_5m_text = str(int(mtf_5m['score']))
        mtf_15m_text = str(int(mtf_15m['score']))
        mtf_1h_text = str(int(mtf_1h['score']))
        mtf_4h_text = str(int(mtf_4h['score']))
        if mtf_5m['score'] > 0:
            mtf_5m_text = '+' + mtf_5m_text
        if mtf_15m['score'] > 0:
            mtf_15m_text = '+' + mtf_15m_text
        if mtf_1h['score'] > 0:
            mtf_1h_text = '+' + mtf_1h_text
        if mtf_4h['score'] > 0:
            mtf_4h_text = '+' + mtf_4h_text
        mtf_text = 'MTF NEEDS 1M CHART'
        mtf_status = 'NEEDS 1M'
        if self._mtf_chart_is_1m:
            if not mtf_ready:
                mtf_status = 'WARMUP'
                mtf_text = 'MTF WARMUP 5m/15m/1h/4h'
            else:
                mtf_status = 'WAIT'
                if mtf_long_ok:
                    mtf_status = 'BUY OK'
                elif mtf_short_ok:
                    mtf_status = 'SELL OK'
                mtf_text = (
                    'MTF 5/15m,1h,4h ' + mtf_5m_text + '/'
                    + mtf_15m_text + '/' + mtf_1h_text + '/'
                    + mtf_4h_text + ' ' + mtf_status
                )

        support_text = 'warming up'
        resistance_text = 'warming up'
        if not isnan(support):
            support_text = str(round(support, price_precision))
        if not isnan(resistance):
            resistance_text = str(round(resistance, price_precision))

        band_text = 'WAIT'
        if not isnan(bb_lower) and not isnan(bb_upper):
            band_text = (
                str(round(bb_lower, price_precision))
                + '/' + str(round(bb_upper, price_precision))
            )

        rsi_display = 'WAIT'
        if not isnan(rsi_value):
            rsi_display = str(round(rsi_value, 1))

        tick_text = 'PRICE STEADY'
        if self.is_last_bar and price_changed:
            if price_went_up:
                tick_text = 'UP TICK'
            elif price_went_down:
                tick_text = 'DOWN TICK'

        volume_short = 'VOL WAIT'
        if volume_ready and not isnan(self.volume[0]):
            volume_short = 'VOL ' + str(round(self.volume[0], 0))
            if volume_ok:
                volume_short = volume_short + ' >AVG'
            else:
                volume_short = volume_short + ' <AVG'

        sim_state_text = 'FLAT'
        if self._sim_side > 0:
            sim_state_text = 'BUY OPEN'
        elif self._sim_side < 0:
            sim_state_text = 'SELL OPEN'
        elif self._pending_side > 0:
            sim_state_text = 'BUY NEXT'
        elif self._pending_side < 0:
            sim_state_text = 'SELL NEXT'
        if self._sim_side > 0 and self._pending_side < 0:
            sim_state_text = 'BUY OPEN / REV WATCH'
        elif self._sim_side < 0 and self._pending_side > 0:
            sim_state_text = 'SELL OPEN / REV WATCH'
        if self._sim_exit_event_bar == self.bar_index:
            if self._sim_exit_event_type == 1:
                sim_state_text = 'TP HIT'
            elif self._sim_exit_event_type == -1:
                sim_state_text = 'STOP HIT'
            elif self._sim_exit_event_type == 2:
                sim_state_text = 'REVERSED'
            elif self._sim_exit_event_type == -2:
                sim_state_text = 'RISK LOCK EXIT'

        active_policy_name = selected_policy_name
        if self._sim_side != 0:
            if self._sim_policy_index == 0:
                active_policy_name = 'SAFE'
            elif self._sim_policy_index == 1:
                active_policy_name = 'BASE'
            else:
                active_policy_name = 'TRAIL'
        policy_slot = regime_index * 3
        context_policy_samples = (
            self._sim_policy_counts[policy_slot]
            + self._sim_policy_counts[policy_slot + 1]
            + self._sim_policy_counts[policy_slot + 2]
        )
        sim_summary = (
            'SIM ' + sim_state_text + ' | N ' + str(self._sim_trade_count)
            + ' TP ' + str(self._sim_tp_count) + ' SL ' + str(self._sim_stop_count)
            + ' REV ' + str(self._sim_reversal_count)
        )
        sim_pnl_label = 'NET P/L/1U ' + str(round(self._sim_realized_pnl, 2))
        if equity_configured:
            sim_pnl_label = 'NET P/L ' + str(round(self._sim_realized_pnl, 2))

        panel_text = (
            'LIVE ' + market_text + ' | ' + price_text + ' | SCORE ' + confluence_text + '\n'
            + tick_text + ' | ' + report_text + '\n'
            + mtf_text + '\n'
            + 'BB L/U ' + band_text + ' | RSI ' + rsi_display + '\n'
            + volume_short + ' | ' + scenario_text + '\n'
            + sim_summary + '\n'
            + 'L/S trader counts: unavailable'
        )

        support_color = color.rgba(0, 180, 0, 1.0)
        resistance_color = color.rgba(255, 0, 180, 1.0)
        if price_changed:
            support_color = color.rgba(0, 255, 0, 1.0)
            resistance_color = color.rgba(255, 0, 255, 1.0)

        self._status_label.text = panel_text
        self._status_label.text_color = color.rgba(255, 255, 255, 1.0)
        self._support_label.text = 'S' + str(level_lookback) + ': ' + support_text
        self._support_label.text_color = support_color
        self._resistance_label.text = 'R' + str(level_lookback) + ': ' + resistance_text
        self._resistance_label.text_color = resistance_color

        trend_reason = 'EMA0'
        if market_trending:
            if ema_up:
                trend_reason = 'EMA+2'
            else:
                trend_reason = 'EMA-2'
        bb_reason = 'BB0'
        if not isnan(bb_middle):
            if self.close[0] > bb_middle:
                bb_reason = 'BB+1'
            elif self.close[0] < bb_middle:
                bb_reason = 'BB-1'
        rsi_reason = 'RSI0'
        if not isnan(rsi_value):
            if rsi_value >= 55.0:
                rsi_reason = 'RSI+1'
            elif rsi_value <= 45.0:
                rsi_reason = 'RSI-1'
        volume_reason = 'VOL0'
        if market_trending and volume_ready and volume_ok:
            if ema_up:
                volume_reason = 'VOL+1'
            else:
                volume_reason = 'VOL-1'
        candle_reason = 'C0'
        if bullish_candle:
            candle_reason = 'C+'
        elif bearish_candle:
            candle_reason = 'C-'

        signal_name = 'WAIT'
        if self._sim_risk_locked:
            signal_name = 'RISK LOCK'
        elif long_candidate:
            signal_name = 'BUY SETUP'
        elif short_candidate:
            signal_name = 'SELL SETUP'
        elif continuous_exposure and long_regime_ready:
            signal_name = 'LONG REGIME'
        elif continuous_exposure and short_regime_ready:
            signal_name = 'SHORT REGIME'
        elif long_mtf_blocked:
            signal_name = 'BUY MTF BLOCK'
        elif short_mtf_blocked:
            signal_name = 'SELL MTF BLOCK'
        elif long_setup_candidate:
            signal_name = 'BUY BLOCKED'
        elif short_setup_candidate:
            signal_name = 'SELL BLOCKED'

        plan_text = 'WAIT: no simulated position'
        if self._sim_risk_locked and self._sim_side == 0:
            plan_text = 'WAIT: HARD DRAWDOWN LOCK'
        if self._sim_exit_event_bar == self.bar_index:
            if self._sim_exit_event_type == 1:
                plan_text = 'TAKE PROFIT FILLED @ ' + str(round(self._sim_exit_event_price, price_precision))
            elif self._sim_exit_event_type == -1:
                plan_text = 'STOP FILLED @ ' + str(round(self._sim_exit_event_price, price_precision))
            elif self._sim_exit_event_type == 2:
                plan_text = 'REVERSED AT OPEN @ ' + str(round(self._sim_exit_event_price, price_precision))
            elif self._sim_exit_event_type == -2:
                plan_text = 'DRAWDOWN LOCK @ ' + str(round(self._sim_exit_event_price, price_precision))
        elif self._sim_side > 0:
            plan_text = (
                'BUY @ ' + str(round(self._sim_entry_price, price_precision))
                + ' SL ' + str(round(self._sim_stop, price_precision))
                + ' TP ' + str(round(self._sim_target, price_precision))
            )
        elif self._sim_side < 0:
            plan_text = (
                'SELL @ ' + str(round(self._sim_entry_price, price_precision))
                + ' SL ' + str(round(self._sim_stop, price_precision))
                + ' TP ' + str(round(self._sim_target, price_precision))
            )
        elif self._pending_side > 0:
            plan_text = (
                'BUY NEXT OPEN | SL ' + str(round(self._pending_stop, price_precision))
                + ' TP ' + str(round(self._pending_target, price_precision))
            )
        elif self._pending_side < 0:
            plan_text = (
                'SELL NEXT OPEN | SL ' + str(round(self._pending_stop, price_precision))
                + ' TP ' + str(round(self._pending_target, price_precision))
            )
        elif long_mtf_blocked or short_mtf_blocked:
            if not self._mtf_chart_is_1m:
                plan_text = 'WAIT: USE A 1M CHART'
            elif not mtf_ready:
                plan_text = 'WAIT: MTF WARMUP'
            else:
                plan_text = 'WAIT: MTF ALIGNMENT FILTER'
        elif long_setup_candidate and not long_risk_ok:
            plan_text = 'BUY BLOCKED: STOP/RR FILTER'
        elif short_setup_candidate and not short_risk_ok:
            plan_text = 'SELL BLOCKED: STOP/RR FILTER'

        cost_text = 'COST ' + str(round(round_trip_cost_pct, 2)) + '%'
        size_text = 'SIM 1 UNIT | ' + cost_text
        if self._sim_risk_locked:
            size_text = 'RISK LOCK | ' + cost_text
        elif not equity_configured:
            size_text = 'SIM 1 UNIT | EQ unset | ' + cost_text
        elif self._sim_side != 0:
            size_text = 'SIM QTY~' + str(round(self._sim_units, 8)) + ' | ' + cost_text
        elif long_candidate and long_risk_unit_distance > 0:
            long_units = risk_budget_quote / long_risk_unit_distance
            size_text = 'PLAN QTY~' + str(round(long_units, 8)) + ' | ' + cost_text
        elif short_candidate and short_risk_unit_distance > 0:
            short_units = risk_budget_quote / short_risk_unit_distance
            size_text = 'PLAN QTY~' + str(round(short_units, 8)) + ' | ' + cost_text
        elif risk_ready:
            size_text = (
                'RISK ' + str(round(risk_per_trade_pct, 2))
                + '% | WAIT | ' + cost_text
            )

        tick_net = self._tick_up_count - self._tick_down_count
        tick_net_text = str(tick_net)
        if tick_net > 0:
            tick_net_text = '+' + tick_net_text
        tick_buy_count_text = str(self._tick_up_count)
        tick_sell_count_text = str(self._tick_down_count)
        tick_buy_caption = 'TICKS/BAR | BUY '
        tick_sell_caption = ' | SELL '
        tick_net_caption = ' | NET '
        tick_line_width = (
            len(tick_buy_caption) + len(tick_buy_count_text)
            + len(tick_sell_caption) + len(tick_sell_count_text)
            + len(tick_net_caption) + len(tick_net_text)
        )

        tick_history_count = len(self._tick_up_history)
        tick_sample_count = tick_history_count + 1
        if tick_sample_count > 20:
            tick_sample_count = 20
        history_start_index = tick_history_count - (tick_sample_count - 1)
        if history_start_index < 0:
            history_start_index = 0
        tick_up_total = self._tick_up_count
        tick_down_total = self._tick_down_count
        history_index = 0
        for old_up_count in self._tick_up_history:
            if history_index >= history_start_index:
                tick_up_total = tick_up_total + old_up_count
            history_index = history_index + 1
        history_index = 0
        for old_down_count in self._tick_down_history:
            if history_index >= history_start_index:
                tick_down_total = tick_down_total + old_down_count
            history_index = history_index + 1
        average_buy_ticks = tick_up_total / (tick_sample_count * 1.0)
        average_sell_ticks = tick_down_total / (tick_sample_count * 1.0)
        tick_average_text = (
            'AVG20 ' + str(tick_sample_count) + '/20 | BUY '
            + str(round(average_buy_ticks, 1))
            + ' SELL ' + str(round(average_sell_ticks, 1))
        )

        why_text = (
            trend_reason + ' ' + bb_reason + ' ' + rsi_reason + ' '
            + volume_reason + ' ' + candle_reason
        )
        analyst_text = (
            self._center_text_line('RULE SIM | NO LIVE ORDERS', tick_line_width) + '\n'
            + self._center_text_line(
                'STATE: ' + sim_state_text + ' | ' + signal_name,
                tick_line_width,
            ) + '\n'
            + self._center_text_line('WHY: ' + why_text, tick_line_width) + '\n'
            + self._center_text_line(plan_text, tick_line_width) + '\n'
            + self._center_text_line(sim_pnl_label, tick_line_width) + '\n'
            + self._center_text_line(size_text, tick_line_width) + '\n'
            + tick_buy_caption + '\n'
            + self._center_text_line(tick_average_text, tick_line_width)
        )
        self._analyst_label.text = analyst_text

        chat_answer = market_text + ' | ' + mtf_status + ' | SCORE ' + confluence_text
        if chart_chat_question == 'Why holding?':
            if self._sim_side > 0:
                chat_answer = 'Hold LONG; opposite confirmation '
                if self._pending_side < 0:
                    chat_answer = (
                        chat_answer + str(self._sim_reverse_confirm_count)
                        + '/' + str(reverse_confirm_bars)
                    )
                else:
                    chat_answer = chat_answer + 'not qualified yet'
            elif self._sim_side < 0:
                chat_answer = 'Hold SHORT; opposite confirmation '
                if self._pending_side > 0:
                    chat_answer = (
                        chat_answer + str(self._sim_reverse_confirm_count)
                        + '/' + str(reverse_confirm_bars)
                    )
                else:
                    chat_answer = chat_answer + 'not qualified yet'
            elif self._pending_side > 0:
                chat_answer = 'LONG queued; rechecked at next open'
            elif self._pending_side < 0:
                chat_answer = 'SHORT queued; rechecked at next open'
            else:
                chat_answer = 'No open position; waiting for a safe regime'
        elif chart_chat_question == 'Risk / levels':
            if self._sim_side > 0:
                chat_answer = (
                    'LONG SL ' + str(round(self._sim_stop, price_precision))
                    + ' TP ' + str(round(self._sim_target, price_precision))
                )
            elif self._sim_side < 0:
                chat_answer = (
                    'SHORT SL ' + str(round(self._sim_stop, price_precision))
                    + ' TP ' + str(round(self._sim_target, price_precision))
                )
            elif self._pending_side > 0:
                chat_answer = (
                    'LONG plan SL ' + str(round(self._pending_stop, price_precision))
                    + ' TP ' + str(round(self._pending_target, price_precision))
                )
            elif self._pending_side < 0:
                chat_answer = (
                    'SHORT plan SL ' + str(round(self._pending_stop, price_precision))
                    + ' TP ' + str(round(self._pending_target, price_precision))
                )
            else:
                chat_answer = 'No valid stop/target plan right now'
        elif chart_chat_question == 'Why waiting?':
            if self._sim_risk_locked:
                chat_answer = 'LOCKED: realized drawdown cap reached'
            elif not self._mtf_chart_is_1m:
                chat_answer = 'Use 1m chart; MTF signals are disabled here'
            elif not mtf_ready:
                chat_answer = 'Building completed 5m/15m/1h/4h context'
            elif self.bar_index < self._sim_cooldown_until_bar:
                chat_answer = 'Post-exit cooldown; safety gate is active'
            elif self._sim_side != 0:
                chat_answer = 'Holding; reversal needs stronger opposite MTF'
            elif self._pending_side != 0:
                chat_answer = 'Queued for next open; gap/risk checks remain'
            elif long_setup_candidate and not long_risk_ok:
                chat_answer = 'LONG blocked by stop distance or net R/R'
            elif short_setup_candidate and not short_risk_ok:
                chat_answer = 'SHORT blocked by stop distance or net R/R'
            elif long_mtf_blocked or short_mtf_blocked:
                chat_answer = 'Waiting for completed higher-timeframe alignment'
            else:
                chat_answer = scenario_text

        chat_risk_text = 'EQ UNSET: 1 unit; % risk cap unavailable'
        if equity_configured:
            chat_risk_text = (
                'DD ' + str(round(self._sim_drawdown_pct, 2)) + '/'
                + str(round(max_drawdown_pct, 1)) + '% | RISK '
                + str(round(risk_per_trade_pct, 2)) + '%'
            )
        if self._sim_risk_locked:
            chat_risk_text = 'RISK LOCK | DD ' + str(round(self._sim_drawdown_pct, 2)) + '%'
        chat_mode_text = 'CONTINUOUS SIM'
        if not continuous_exposure:
            chat_mode_text = 'SETUP-ONLY SIM'
        if high_volatility:
            volatility_text = 'HIGH VOL'
        else:
            volatility_text = 'VOL OK'
        chat_policy_text = (
            'EXIT ' + active_policy_name + ' | SAMPLES '
            + str(int(context_policy_samples)) + ' | ' + volatility_text
        )
        self._chat_label.text = (
            'JET CHAT | RULE-BASED\n'
            + 'Q: ' + chart_chat_question + '\n'
            + 'A: ' + chat_answer + '\n'
            + 'SIM: ' + sim_state_text + ' | ' + chat_mode_text + '\n'
            + chat_policy_text + '\n'
            + chat_risk_text + '\n'
            + 'PAPER ONLY - NO LIVE ORDERS'
        )
        self._chat_label.text_color = color.rgba(235, 243, 255, 1.0)

        # Keep captions white; only the numeric buy/sell counters flash.
        self._tick_buy_count_label.text = tick_buy_count_text
        self._tick_sell_caption_label.text = tick_sell_caption
        self._tick_sell_count_label.text = tick_sell_count_text
        self._tick_net_caption_label.text = tick_net_caption
        self._tick_net_value_label.text = tick_net_text
        buy_count_color = color.rgba(255, 255, 255, 1.0)
        sell_count_color = color.rgba(255, 255, 255, 1.0)
        if self._tick_flash_side > 0:
            buy_count_color = color.rgba(0, 255, 0, 1.0)
        elif self._tick_flash_side < 0:
            sell_count_color = color.rgba(255, 0, 0, 1.0)
        self._tick_buy_count_label.text_color = buy_count_color
        self._tick_sell_count_label.text_color = sell_count_color
        self._tick_net_value_label.text_color = color.rgba(255, 255, 255, 1.0)
        self.chart.draw(self._status_label)
        self.chart.draw(self._support_label)
        self.chart.draw(self._resistance_label)
        self.chart.draw(self._analyst_label)
        self.chart.draw(self._chat_label)
        self.chart.draw(self._tick_buy_count_label)
        self.chart.draw(self._tick_sell_caption_label)
        self.chart.draw(self._tick_sell_count_label)
        self.chart.draw(self._tick_net_caption_label)
        self.chart.draw(self._tick_net_value_label)

        ema_up_plot = nan
        ema_down_plot = nan
        if ema_up:
            ema_up_plot = fast_ema[0]
        else:
            ema_down_plot = fast_ema[0]

        # Return only scalar series values, one per plot decorator, in decorator order.
        # This avoids the IOOutputValue wrappers Exness reported for plot.Line/plot.Fill.
        return (
            ema_up_plot,
            ema_down_plot,
            support,
            resistance,
            bb_lower,
            bb_upper,
            buy_entry_marker,
            sell_entry_marker,
            tp_reference_marker,
            stop_reference_marker,
            tp_exit_marker,
            stop_exit_marker,
        )
