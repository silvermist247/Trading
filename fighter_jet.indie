# indie:lang_version = 5
from math import isnan, nan
from indie import MainContext, color, indicator, param, plot
from indie.algorithms import Atr, Bb, Ema, Highest, Lowest, Rsi, Sma
from indie.drawings import (
    AbsolutePosition,
    LabelRel,
    LineSegment,
    RelativePosition,
    horizontal_anchor as ha,
    vertical_anchor as va,
)


# Rule-based OHLCV paper simulator with small in-session entry/exit learners;
# it is not a true AI service, durable learner, broker integration, or order system.
# The entry learner only tightens future flat-entry score gates after poor simulated outcomes;
# optional fast mode lowers the flat-entry baseline by one point (floor 2) for more samples.
# Stop/RR, risk sizing, cooldown, full-MTF reversal safeguards and live-order behavior are unchanged.
# Run on a 1-minute chart: completed 1m candles feed 5m, 15m, 1h, 4h, and UTC-day research bars.
# The existing trade gate still uses only 5m/15m/1h/4h and keeps its prior warmup and safeguards.
# The daily NN/KNN, S/R learner, MACD vote, and weighted consensus are shadow diagnostics.
# The selected style sets simulated TP1/TP2 partials inside the existing TP3 target; the entry
# stop/RR gate and initial risk sizing still use the full TP3 plan. These are paper fills only.
# A confirmed daily-stress flag only vetoes fresh entries at planning/next-open checks; it does
# not force-close existing exposure or loosen stops, sizing, MTF, cooldown, or drawdown rules.
# Daily bars are UTC buckets, not broker sessions.
# Other chart intervals block entries. MTF scores use completed bars; 1m conditions can change intrabar.
# Higher-timeframe volume is the chart's volume field (possibly tick volume), not trader counts.
# Pending signals are rechecked at the next 1m open. Stops/TPs use candle ranges; if a stop and
# any target are touched in one bar, the simulator assumes the stop hit first. If multiple TPs
# are touched without a stop hit, partial targets fill sequentially. Learning state resets on reload.
# Swing-reversal candidates approximate local OHLCV/RSI turns; manual chart drawings are not inputs.
# Proxy arrows are drawn once on the next candle after a closed-bar candidate; they are not order fills.
# Equity is optional: without it, trades use one simulated unit and percent risk/drawdown caps
# cannot be calculated. No live orders are placed. Costs are estimates; actual execution differs.
@indicator('Fighter-Jet Radar - Paper Trade Simulator', overlay_main_pane=True)
@param.int('trend_length', default=9, min=1, max=250, title='Trend EMA base length')
@param.int('radar_length', default=14, min=1, max=250, title='ATR length')
@param.int('volume_sma', default=20, min=1, max=500, title='Volume baseline lookback (bars)')
@param.int('level_lookback', default=10, min=2, max=500, title='Support / resistance lookback (bars)')
@param.int('swing_proxy_lookback', default=3, min=3, max=30, title='Swing-reversal proxy lookback (bars)')
@param.float('swing_proxy_tolerance_atr', default=0.5, min=0.05, max=0.75, step=0.05, title='Swing-reversal level tolerance (ATR)')
@param.int('band_length', default=20, min=2, max=250, title='Bollinger length')
@param.float('band_multiplier', default=2.0, min=0.5, max=4.0, step=0.1, title='Bollinger deviation')
@param.int('rsi_length', default=14, min=2, max=250, title='RSI length')
@param.float('tp_atr_multiple', default=1.5, min=0.5, max=4.0, step=0.1, title='TP reference (ATR multiple)')
@param.float('stop_buffer_atr', default=0.2, min=0.05, max=1.0, step=0.05, title='Structural stop buffer (ATR)')
@param.float('max_stop_atr', default=2.0, min=0.5, max=5.0, step=0.1, title='Maximum initial stop distance (ATR)')
@param.float('min_reward_risk', default=1.5, min=0.5, max=4.0, step=0.1, title='Minimum estimated net reward/risk')
@param.float('pullback_tolerance_atr', default=0.4, min=0.05, max=1.0, step=0.05, title='EMA pullback tolerance (ATR)')
@param.int('minimum_entry_score', default=3, min=2, max=5, title='Minimum entry score (lower = more signals)')
@param.bool(
    'fast_learning_mode',
    default=True,
    title='Fast learning mode (one-point lower flat-entry score)',
)
@param.float('risk_per_trade_pct', default=0.25, min=0.05, max=1.0, step=0.05, title='Risk budget (% of equity)')
@param.float('round_trip_cost_pct', default=0.0, min=0.0, max=2.0, step=0.05, title='Estimated round-trip costs (% notional; set broker estimate)')
@param.float('account_equity_quote', default=0.0, min=0.0, max=1000000000.0, step=1.0, title='Optional equity in chart quote currency (0 simulates 1 unit)')
@param.bool('continuous_exposure', default=True, title='Continuous simulated long/short exposure')
@param.bool(
    'opportunity_entries',
    default=True,
    title='Allow entries with aligned 5m before full MTF warm-up',
)
@param.int('reverse_confirm_bars', default=2, min=1, max=5, title='Opposite-regime confirmation (closed 1m bars)')
@param.int('stop_cooldown_bars', default=1, min=1, max=20, title='Cooldown after TP/SL (1m bars)')
@param.float('max_drawdown_pct', default=5.0, min=1.0, max=50.0, step=0.5, title='Hard cap: realized drawdown from peak (%)')
@param.str(
    'research_style',
    default='Day',
    options=['Scalp', 'Day', 'Swing'],
    title='SIM TP ladder and SFX shadow sensitivity style',
)
@param.str(
    'chart_chat_question',
    default='Market read',
    options=['Market read', 'Why holding?', 'Risk / levels', 'Why waiting?'],
    title='Top-right chart chat prompt (select in settings)',
)
@plot.line(
    id='ema_up', title='EMA uptrend',
    color=color.rgba(0, 255, 0, 1.0), line_width=2,
)
@plot.line(
    id='ema_down', title='EMA downtrend',
    color=color.rgba(255, 0, 255, 1.0), line_width=2,
)
@plot.line(
    id='support_level', title='Dynamic rolling support',
    color=color.rgba(0, 180, 0, 1.0), line_width=2,
)
@plot.line(
    id='resistance_level', title='Dynamic rolling resistance',
    color=color.rgba(255, 0, 180, 1.0), line_width=2,
)
@plot.line(id='bb_lower', title='Bollinger lower band', color=color.rgba(50, 170, 255, 0.8), line_width=1)
@plot.line(id='bb_upper', title='Bollinger upper band', color=color.rgba(50, 170, 255, 0.8), line_width=1)
@plot.marker(
    title='Simulated BUY entry bubble',
    color=color.rgba(0, 255, 0, 1.0),
    style=plot.marker_style.CIRCLE,
    position=plot.marker_position.CENTER,
    size=4,
    display_options=plot.MarkerDisplayOptions(
        pane=True, status_line=False, price_label=False,
    ),
)
@plot.marker(
    title='Simulated SELL entry bubble',
    color=color.rgba(255, 0, 0, 1.0),
    style=plot.marker_style.CIRCLE,
    position=plot.marker_position.CENTER,
    size=4,
    display_options=plot.MarkerDisplayOptions(
        pane=True, status_line=False, price_label=False,
    ),
)
@plot.line(
    id='sim_tp_reference', title='Active simulated TP target',
    color=color.rgba(255, 165, 0, 1.0), line_width=2,
)
@plot.line(
    id='sim_sl_reference', title='Active simulated SL stop',
    color=color.rgba(255, 220, 0, 1.0), line_width=2,
)
@plot.marker(
    title='Simulated take-profit fill',
    color=color.rgba(0, 255, 0, 1.0),
    style=plot.marker_style.CIRCLE,
    position=plot.marker_position.CENTER,
    size=4,
    display_options=plot.MarkerDisplayOptions(
        pane=True, status_line=False, price_label=False,
    ),
)
@plot.marker(
    title='Simulated stop-loss fill',
    color=color.rgba(255, 0, 0, 1.0),
    style=plot.marker_style.CIRCLE,
    position=plot.marker_position.CENTER,
    size=4,
    display_options=plot.MarkerDisplayOptions(
        pane=True, status_line=False, price_label=False,
    ),
)
